package.json name "android-emulator-app" section:

{
  "name": "android-emulator-app",
  "version": "1.0.0",
  "description": "Android Emulator Control App - React Native with Expo",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "build:apk": "eas build --platform android --local",
    "build:aab": "eas build --platform android --local --output=./build.aab",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.72.3",
    "expo": "^49.0.0",
    "expo-status-bar": "^1.6.0",
    "@react-navigation/native": "^6.1.7",
    "@react-navigation/bottom-tabs": "^6.5.8",
    "axios": "^1.5.0",
    "zustand": "^4.4.1",
    "react-native-vector-icons": "^10.0.0",
    "@react-native-camera-roll/camera-roll": "^6.0.2",
    "react-native-gesture-handler": "^2.13.2",
    "react-native-reanimated": "^3.3.0",
    "nativewind": "^2.0.11",
    "tailwindcss": "^3.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "typescript": "^5.1.6",
    "jest": "^29.6.2",
    "@testing-library/react-native": "^12.1.2",
    "eslint": "^8.45.0",
    "eslint-config-universe": "^12.0.0"
  },
  "expo": {
    "name": "Android Emulator Controller",
    "slug": "android-emulator-app",
    "version": "1.0.0",
    "scheme": "emulatorapp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow app to access your camera"
        }
      ]
    ],
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.emulatorapp.controller"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  },
  "private": true
}
